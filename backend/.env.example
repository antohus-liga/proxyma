# Copy this file to .env and fill in local values. Never commit .env.

# Interface the HTTP server binds to. Defaults to 127.0.0.1; use 0.0.0.0 to
# expose the API on the LAN (set PROXYMA_CORS_ALLOWED_ORIGINS as needed).
PROXYMA_SERVER_ADDRESS=127.0.0.1

# Comma-separated reverse proxies whose X-Forwarded-For header is trusted.
# Defaults to loopback, which covers the local Vite dev proxy. Add the Vite
# host's address if the dashboard proxies from another machine. Never add a
# network that clients can connect from directly, or they can spoof their IP.
PROXYMA_HTTP_TRUSTED_PROXIES=127.0.0.1/32,::1/128

DB_URL=jdbc:postgresql://localhost:5432/proxyma_db
DB_USERNAME=proxyma_u
DB_PASSWORD=change-me

# At least 32 random bytes, base64-encoded:
#   openssl rand -base64 32
PROXYMA_JWT_SECRET=replace-me-with-openssl-rand-base64-32

# Keep true for localhost. Set to false only when serving the app over plain
# HTTP on a LAN address, where browsers refuse Secure cookies.
PROXYMA_COOKIE_SECURE=true

# Comma-separated browser origins allowed to call the API (e.g.
# http://localhost:5173 for a separately served dashboard). Empty means no
# cross-origin browser access; the dashboard must use a same-origin proxy.
# Credentials are enabled, so a wildcard is not allowed.
PROXYMA_CORS_ALLOWED_ORIGINS=

# Platform administration. Off by default: while false every /api/v1/admin
# route returns 404. Grant the first admin with the server-side command
#   ./gradlew bootRun --args='grant-admin you@example.com'
# Optional comma-separated source-network allowlist (e.g. 127.0.0.1/32).
# Empty means no network restriction.
PROXYMA_ADMIN_ENABLED=false
PROXYMA_ADMIN_ALLOWED_CIDRS=
# Per-admin request budgets. The first applies to every /api/v1/admin route;
# the second is the stricter budget for suspend and force-logout.
PROXYMA_ADMIN_RATE_LIMIT_REQUESTS_PER_MINUTE=120
PROXYMA_ADMIN_RATE_LIMIT_RISKY_PER_MINUTE=10
