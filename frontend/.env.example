# Copy this file to .env and adjust local values. Never commit .env.

# Backend the Vite dev server proxies /api to. Omit to use
# http://localhost:8080, or point it at the machine running the API, e.g.
# http://192.168.1.86:8080 when the Vite server is reached over the LAN.
VITE_BACKEND_URL=http://localhost:8080
